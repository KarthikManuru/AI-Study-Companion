generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  USER
  ADMIN
}

enum MaterialStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum MasteryTrend {
  IMPROVING
  STABLE
  NEEDS_ATTENTION
}

enum QuestionType {
  MCQ
  OPEN
}

enum QuizStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum RecommendationStatus {
  ACTIVE
  DISMISSED
  DONE
}

enum LearningContextKind {
  GOAL
  STRENGTH
  WEAKNESS
  PREFERENCE
  MISTAKE_PATTERN
}

// ─── USER ──────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  spaces         Space[]
  conversations  Conversation[]
  learningEvents LearningEvent[]

  @@map("users")
}

// ─── SPACE ─────────────────────────────────────────────

model Space {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String   @default("")
  color       String   @default("#4c6ef5")
  icon        String   @default("📚")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([userId])
  @@map("spaces")
}

// ─── PROJECT ───────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  spaceId     String
  name        String
  description String   @default("")
  goal        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  space            Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  materials        Material[]
  concepts         Concept[]
  conceptMasteries ConceptMastery[]
  conversations    Conversation[]
  quizAttempts     QuizAttempt[]
  recommendations  Recommendation[]
  learningEvents   LearningEvent[]
  learningContexts LearningContext[]

  @@index([spaceId])
  @@map("projects")
}

// ─── MATERIAL ──────────────────────────────────────────

model Material {
  id            String         @id @default(cuid())
  projectId     String
  fileName      String
  storageUrl    String
  status        MaterialStatus @default(QUEUED)
  failureReason String?
  pageCount     Int?
  fileSize      Int?
  mimeType      String         @default("application/pdf")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks  Chunk[]

  @@index([projectId])
  @@index([status])
  @@map("materials")
}

// ─── CHUNK (retrieval unit with vector embedding) ──────

model Chunk {
  id         String   @id @default(cuid())
  materialId String
  pageNumber Int
  content    String
  embedding  Unsupported("vector(768)")?
  chunkIndex Int      @default(0)
  createdAt  DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@map("chunks")
}

// ─── CONCEPT ───────────────────────────────────────────

model Concept {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())

  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conceptMasteries ConceptMastery[]
  questions        Question[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("concepts")
}

// ─── CONCEPT MASTERY ───────────────────────────────────

model ConceptMastery {
  id             String       @id @default(cuid())
  projectId      String
  conceptId      String
  masteryScore   Float        @default(50)
  lastEvidenceAt DateTime     @default(now())
  trend          MasteryTrend @default(STABLE)
  history        Json         @default("[]")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([projectId, conceptId])
  @@index([projectId])
  @@map("concept_masteries")
}

// ─── CONVERSATION & MESSAGES ───────────────────────────

model Conversation {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  title     String   @default("New Conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([projectId])
  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // "user" | "assistant" | "system"
  content        String
  citations      Json?    // [{materialId, materialName, pageNumber, chunkId, excerpt}]
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

// ─── QUIZ & ASSESSMENT ─────────────────────────────────

model QuizAttempt {
  id          String     @id @default(cuid())
  projectId   String
  status      QuizStatus @default(IN_PROGRESS)
  totalScore  Float?
  startedAt   DateTime   @default(now())
  completedAt DateTime?

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([projectId])
  @@map("quiz_attempts")
}

model Question {
  id            String       @id @default(cuid())
  quizAttemptId String
  conceptId     String?
  type          QuestionType
  difficulty    Int          @default(3) // 1-5 scale
  prompt        String
  choices       Json?        // For MCQ: [{id, text, isCorrect}]
  correctAnswer String?      // For MCQ: the correct choice id
  explanation   String?
  createdAt     DateTime     @default(now())

  quizAttempt QuizAttempt @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)
  concept     Concept?    @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  answer      Answer?

  @@index([quizAttemptId])
  @@map("questions")
}

model Answer {
  id              String   @id @default(cuid())
  questionId      String   @unique
  userAnswer      String
  isCorrect       Boolean?
  score           Float?   // 0-100
  feedback        String?
  missingConcepts Json?    // ["concept1", "concept2"]
  createdAt       DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("answers")
}

// ─── RECOMMENDATION ────────────────────────────────────

model Recommendation {
  id        String               @id @default(cuid())
  projectId String
  text      String
  reason    String
  status    RecommendationStatus @default(ACTIVE)
  priority  Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("recommendations")
}

// ─── LEARNING EVENT (append-only event log) ────────────

model LearningEvent {
  id             String   @id @default(cuid())
  userId         String
  projectId      String?
  type           String   // e.g. "material.uploaded", "tutor.interaction", "quiz.completed"
  payload        Json     @default("{}")
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([type])
  @@index([createdAt])
  @@map("learning_events")
}

// ─── AI USAGE LOG (observability) ──────────────────────

model AiUsageLog {
  id               String   @id @default(cuid())
  userId           String?
  projectId        String?
  feature          String   // "tutor", "quiz_generation", "quiz_grading", "recommendation", "concept_extraction", "evaluation"
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  latencyMs        Int      @default(0)
  costUsd          Float    @default(0)
  success          Boolean  @default(true)
  errorMessage     String?
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([feature])
  @@index([createdAt])
  @@index([userId])
  @@map("ai_usage_logs")
}

// ─── EVAL RESULT ───────────────────────────────────────

model EvalResult {
  id         String   @id @default(cuid())
  feature    String
  testCaseId String
  passed     Boolean
  score      Float?
  notes      String?
  createdAt  DateTime @default(now())

  @@index([feature])
  @@map("eval_results")
}

// ─── LEARNING CONTEXT (persistent but relevant) ────────

model LearningContext {
  id             String              @id @default(cuid())
  projectId      String
  kind           LearningContextKind
  content        String
  relevanceScore Float               @default(1.0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([kind])
  @@map("learning_contexts")
}
