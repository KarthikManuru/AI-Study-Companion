# Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql://user:password@hostname:5432/dbname?sslmode=require"

# NextAuth Configuration
NEXTAUTH_SECRET="generate-a-strong-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# AI Model Providers
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
OPENAI_API_KEY="your-openai-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"

# Background Worker & Cache (Redis)
REDIS_URL="rediss://default:password@hostname:6379"

# Application Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Secret Key (required for administrative account creation)
ADMIN_SECRET_KEY="generate-a-secure-32-character-random-admin-secret"
